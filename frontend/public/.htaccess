# =============================================================================
# Shivaraj Maratha PWA - Apache configuration
# Served from the domain document root (Hostinger: public_html/PWA/).
# Vite copies this file (public/.htaccess) into the build output verbatim.
# =============================================================================

# Correct MIME types so module scripts are never served as text/plain.
<IfModule mod_mime.c>
  AddType application/javascript    .js .mjs
  AddType text/css                  .css
  AddType application/manifest+json .webmanifest
  AddType application/json          .json
  AddType image/svg+xml             .svg
  AddType image/png                 .png
  AddType image/x-icon              .ico
  AddType font/woff2                .woff2
</IfModule>
AddDefaultCharset UTF-8

# No directory listings; disable content negotiation (MultiViews can mislabel
# MIME types and break module loading).
Options -Indexes -MultiViews

# Never serve secrets, VCS metadata, dependency manifests or source maps.
<FilesMatch "(^\.|\.env$|\.env\.|composer\.(json|lock)$|package(-lock)?\.json$|phpunit\.xml$|\.map$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Defence in depth: block backend/source directories if they ever land here.
  RewriteRule ^(src|backend|node_modules|vendor|storage|tests|database|routes|config|resources)(/|$) - [F,L]
  RewriteRule ^(vite\.config\.[a-z]+|tsconfig.*\.json|artisan)$ - [F,L]

  # Existing files and directories (hashed assets, icons, manifest, sw.js) win.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite API traffic into the SPA shell.
  RewriteRule ^api(s)?(/|$) - [L]

  # Everything else is a client-side route: serve the app shell.
  RewriteRule . /index.html [L]
</IfModule>

# Caching: hashed assets forever; the shell and service worker always revalidate.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|registerSW\.js|workbox-.*\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Compress text responses on the fly.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

DirectoryIndex index.html
