APP_NAME="Shivaraj Maratha"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pwa.digitalji.in
APP_TIMEZONE=Asia/Kolkata

# Origin of the PWA. Drives CORS (see config/cors.php). No trailing slash.
# Same domain as APP_URL: the Laravel app is served under /api on the PWA
# subdomain, so there is no separate API host.
FRONTEND_URL=https://pwa.digitalji.in

APP_LOCALE=mr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# The current backend only exposes a health check, so it runs with no database.
# Switch DB_CONNECTION to mysql and fill the DB_* block once real tables land.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# File-based drivers avoid needing database tables for sessions/cache/queues.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
