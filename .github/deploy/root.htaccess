# Shivaraj Maratha PWA — production web root routing.
#
# The published tree (branch `deploy`) is:
#   /            built PWA (index.html, assets/, icons/, sw.js, ...)
#   /api/        Laravel application (public front controller at api/public/index.php)
#
# This file routes /api/* into Laravel and falls back to the SPA for everything else.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose Laravel internals over HTTP.
    RewriteRule ^api/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Every other /api/* request is handled by Laravel's front controller.
    # The !-f guard stops Apache from re-rewriting api/public/index.php itself.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api(/.*)?$ api/public/index.php [L,QSA]

    # Serve real files and directories (assets, icons, service worker, ...).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA history fallback.
    RewriteRule ^ index.html [L]
</IfModule>
